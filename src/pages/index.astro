---
import Base from '../layouts/Base.astro';
import RedeFooter from '../components/RedeFooter.astro';
import SiteNav from '../components/SiteNav.astro';
import { cursos } from '../data/cursos';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'EducationalOrganization',
  name: 'Academia Loops Brasil',
  alternateName: 'ALB',
  url: 'https://academia.loopsbrasil.com.br',
};

// video de fundo do hero via Vimeo, 25/07
const HERO_VIMEO_ID = '1115000142';
const heroVimeoEmbed = `https://player.vimeo.com/video/${HERO_VIMEO_ID}?background=1&autoplay=1&loop=1&muted=1&byline=0&title=0&portrait=0`;
---
<Base
  title="Academia Loops Brasil (ALB) | Cursos de Produção Fonográfica"
  description="Academia Loops Brasil. Cursos de Produção Fonográfica para quem vive a música."
  redeAtual="Academia Loops Brasil"
  structuredData={structuredData}
>
  <SiteNav slot="nav" />
  <main id="topo">
  <section class="relative flex min-h-screen flex-col items-center justify-center overflow-hidden px-4 pb-16 pt-28 sm:px-6 sm:pt-36">
    <div class="hero-vimeo-wrap" aria-hidden="true">
      <iframe
        class="hero-vimeo-iframe"
        src={heroVimeoEmbed}
        title=""
        allow="autoplay; fullscreen; picture-in-picture"
        tabindex="-1"
      ></iframe>
    </div>
    <div class="absolute inset-0 bg-gradient-to-b from-black/80 via-black/15 to-black"></div>

    <div class="relative mx-auto flex w-full max-w-2xl flex-col items-center text-center [text-shadow:0_1px_3px_rgba(0,0,0,0.85),0_2px_10px_rgba(0,0,0,0.5)]">
      <h1 class="font-hero text-8xl uppercase leading-none text-brand-red sm:text-9xl">ALB</h1>
      <p class="mt-3 font-hero text-xl uppercase tracking-[0.25em] text-paper sm:text-2xl">
        Academia Loops Brasil
      </p>
      <div class="mt-3 flex items-center gap-3 text-paper/50">
        <span class="h-px w-8 bg-paper/30"></span>
        <p class="text-[11px] font-semibold uppercase tracking-[0.3em]">Produção Fonográfica</p>
        <span class="h-px w-8 bg-paper/30"></span>
      </div>
      <p class="balance mt-[5px] max-w-md font-display text-base leading-snug tracking-wide text-paper">
        Cursos de Produção Fonográfica para quem vive a música.
      </p>
      <p class="balance mt-4 max-w-md text-sm text-paper/60">
        Os cursos da ED Tutoriais passam a ficar dentro da Academia Loops
        Brasil, e novos cursos estão a caminho. Fique de olho.
      </p>
    </div>
  </section>

  <div class="flex flex-col items-center px-4 pb-16 sm:px-6">
    <div id="cursos" class="mx-auto mt-16 w-full max-w-5xl px-4 sm:px-0">
      <h2 class="text-center font-hero text-2xl text-paper sm:text-3xl">Os cursos de hoje</h2>
      <p class="mx-auto mt-3 max-w-lg text-center text-sm text-paper/60">
        Esses são os cursos da ED Tutoriais, já com página própria e vídeo aqui
        na Academia Loops Brasil.
      </p>

      <div class="mt-10 grid gap-4 sm:grid-cols-2">
        {cursos.map((c, i) => (
          <a
            href={`/${c.slug}`}
            class:list={[
              'media-card group relative flex flex-col overflow-hidden bg-ink-raised',
              i === cursos.length - 1 && cursos.length % 2 !== 0 && 'sm:col-span-2 sm:mx-auto sm:w-full sm:max-w-[calc(50%-0.5rem)]',
            ]}
          >
            <span class="relative block aspect-video w-full overflow-hidden">
              <img
                src={`https://img.youtube.com/vi/${c.videoId}/maxresdefault.jpg`}
                alt={`Capa do curso ${c.titulo}`}
                loading="lazy"
                class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
              />
              <span class="pointer-events-none absolute inset-0 bg-black/30" />
              {c.badge && (
                <span class="absolute left-3 top-3 inline-block rounded-full bg-brand-red px-2.5 py-1 text-[10px] font-semibold uppercase tracking-wide text-white">
                  {c.badge}
                </span>
              )}
              <span class="absolute inset-x-0 bottom-0 bg-ink/90 p-4">
                <p class="font-display text-base font-semibold leading-tight text-white">{c.titulo}</p>
                <span class="mt-2 flex items-baseline gap-2">
                  <span class="font-display text-lg text-white">{c.preco}</span>
                  {c.parcela && <span class="text-[11px] text-white/60">{c.parcela}</span>}
                </span>
              </span>
            </span>
          </a>
        ))}
      </div>
    </div>

    <div class="mx-auto mt-20 w-full max-w-5xl px-4 sm:px-0">
      <RedeFooter atual="Academia Loops Brasil" />
    </div>
  </div>
  </main>
</Base>
