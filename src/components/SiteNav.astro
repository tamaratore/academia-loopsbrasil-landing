---
// Toré pediu (24/07): mesmo esquema de menu do emmusicproducoes (logo + links
// de secao). Sem redes sociais aqui - a Academia ainda nao tem conta propria
// confirmada (marca nova, redes ainda nao). Sem CTA - pagina "em breve",
// nao vende nada direto (quem vende sao os cursos individuais).
// Logo em imagem tentada 24/07, mas o arquivo fonte tinha defeitos reais
// dificeis de corrigir - Tore pediu pra voltar a ser so texto "ALB" na
// fonte do mesmo estilo (font-hero/Anton, igual o resto da marca).
// 26/07: Toré pediu link direto pro "Sobre" (historia da rede) e pra "Rede
// Loops Brasil" (hub) tambem aqui na barra de baixo, alem do que ja existe
// na barra de cima (RedeSwitcher/"Conhecer a rede").
const LINKS = [
  { href: '#topo', label: 'Início' },
  { href: '#cursos', label: 'Cursos' },
  { href: 'https://rede.loopsbrasil.com.br/nossa-historia', label: 'Sobre' },
  { href: 'https://rede.loopsbrasil.com.br', label: 'Rede Loops Brasil' },
];
---
<div id="site-nav" class="hidden sm:block">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-3 sm:px-6">
    <a href="#topo" class="flex shrink-0 items-baseline gap-2">
      <span class="font-hero text-2xl uppercase leading-none text-brand-red">ALB</span>
      <span class="font-hero text-[9px] uppercase leading-tight tracking-[0.15em] text-paper/60">
        Academia<br />Loops Brasil
      </span>
    </a>

    <nav class="hidden items-center gap-6 md:flex">
      {LINKS.map((l) => (
        <a
          href={l.href}
          class="font-accent text-sm uppercase tracking-[0.15em] text-paper transition hover:text-brand-red"
        >
          {l.label}
        </a>
      ))}
    </nav>
  </div>
</div>
